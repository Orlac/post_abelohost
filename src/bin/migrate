#!/usr/bin/env php
<?php

declare(strict_types=1);
require __DIR__ . '/../vendor/autoload.php';

use app\components\Migrator;
use app\components\MysqlDatabase;

function usage(): void
{
    echo 'Usage: php bin/migrate <command> [args]' . PHP_EOL;
    echo 'Commands:' . PHP_EOL;
    echo '  up            Apply all pending migrations' . PHP_EOL;
    echo '  down [steps]  Rollback last N migrations (default: 1)' . PHP_EOL;
    echo '  status        Show migration list' . PHP_EOL;
    echo '  create <name> Create new migration file' . PHP_EOL;
}

$command = $argv[1] ?? 'help';

try {
    $migrator = new Migrator(MysqlDatabase::fromEnv()->connect(), __DIR__ . '/../migrations');

    switch ($command) {
        case 'up':
            $applied = $migrator->migrate();

            if ($applied === []) {
                echo 'No pending migrations.' . PHP_EOL;
            }

            foreach ($applied as $name) {
                echo "Applied: {$name}" . PHP_EOL;
            }
            break;
        case 'down':
            $steps = max(1, (int) ($argv[2] ?? 1));
            $rolledBack = $migrator->rollback($steps);

            if ($rolledBack === []) {
                echo 'Nothing to rollback.' . PHP_EOL;
            }

            foreach ($rolledBack as $name) {
                echo "Rolled back: {$name}" . PHP_EOL;
            }
            break;
        case 'status':
            foreach ($migrator->status() as $item) {
                printf('%s %s' . PHP_EOL, $item['applied'] ? '[x]' : '[ ]', $item['name']);
            }
            break;
        case 'create':
            $name = $argv[2] ?? '';
            if ($name === '') {
                echo 'Error: Migration name required.' . PHP_EOL;
                echo 'Usage: php bin/migrate create <name>' . PHP_EOL;
                exit(1);
            }
            $created = createMigration($name, __DIR__ . '/../migrations');
            echo "Created: {$created}" . PHP_EOL;
            break;
        default:
            usage();
    }
} catch (Throwable $e) {
    echo 'Error: ' . $e->getMessage() . PHP_EOL;

    exit(1);
}

function createMigration(string $name, string $dir): string
{
    $timestamp = date('YmdHis');
    $className = 'Version' . $timestamp . '_' . ucfirst(str_replace(['-', '_'], '', $name));
    $fileName = $className . '.php';
    $path = $dir . '/' . $fileName;

    // Convert name to snake_case table name
    $table = strtolower(preg_replace('/([a-z])([A-Z])/', '$1_$2', ucfirst(str_replace(['-', '_'], '', $name))));
    $table = strtolower($name); // Simple: just use the name as-is in lowercase

    $content = <<<'PHP'
<?php

declare(strict_types=1);

namespace app\migrations;

use app\components\Migration;

class %s extends Migration
{
    public function up(): void
    {
        $this->db->exec(
            <<<SQL
            
            SQL
        );
    }

    public function down(): void
    {
        $this->db->exec(<<<SQL
            
            SQL);
    }
}
PHP;

    $content = sprintf($content, $className, $table, $table);

    file_put_contents($path, $content);

    return $fileName;
}
